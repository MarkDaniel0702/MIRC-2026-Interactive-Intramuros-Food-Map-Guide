# Secrets. API keys live in `wrangler secret put`, never in the repo — this site is
# public, and anything committed here is served from GitHub Pages.
.dev.vars
.dev.vars.*
.env
.env.*
*.key

# Wrangler build/state
worker/.wrangler/
node_modules/

# Vite build output -- published by .github/workflows/deploy.yml, not committed
dist/
.vite/
*.local
.DS_Store

# TypeScript project-reference build cache (tsc -b)
*.tsbuildinfo
